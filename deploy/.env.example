# Copy to ../.env at repo root and edit. NEVER commit .env.

# ---- Backend / DB ----
# Points at YOUR existing MySQL on the VPS.
#   format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/musika"

# If you want the compose file to run its own MySQL 8 instead, uncomment:
# db:  (in docker-compose.yml add the service out of "db" profile)
DB_ROOT_PASSWORD="musika"
DB_NAME="musika"

# Secret used to sign JWTs — CHANGE THIS (use: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"

# Allow the browser origin (Nginx same-origin => leave as *)
CLIENT_ORIGIN="*"

# ---- Optional: only needed if the backend can't reach MySQL via localhost ----
# (e.g. MySQL is on another box) — already covered by DATABASE_URL host.
